generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id  Int    @id @default(autoincrement())
  ime String
}

model Post {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
}
